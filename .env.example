# ---------------------------------------------------------------------------
# Malolos Weather Monitor — example environment configuration
# Copy this file to `.env` and fill in the values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Port the Express server listens on.
PORT=3000

# Node environment: development | production
NODE_ENV=development

# --- WeatherAPI.com (primary source: current, hourly, alerts, astronomy) ------
# Get a free key at https://www.weatherapi.com/signup.aspx
# The app still boots without this, but current/hourly/alerts endpoints will
# return a clear "unavailable" error until a key is provided.
WEATHER_API_KEY=
WEATHER_API_BASE=https://api.weatherapi.com/v1

# --- Open-Meteo (no key required: 7-day daily forecast + historical) ----------
OPEN_METEO_BASE=https://api.open-meteo.com/v1

# Number of days for the daily forecast (Open-Meteo supports up to 16).
FORECAST_DAYS=7

# --- Caching ------------------------------------------------------------------
# How long (minutes) to cache upstream weather responses. Reduces API calls.
WEATHER_CACHE_MINUTES=10
HISTORY_CACHE_MINUTES=360
SEARCH_CACHE_MINUTES=60

# --- Database (OPTIONAL) ------------------------------------------------------
# The app runs fully without a database. Set this to enable history persistence,
# user accounts, and preferences. Example:
# DATABASE_URL=postgresql://user:password@localhost:5432/malolos_weather
DATABASE_URL=

# --- Authentication (only used when DATABASE_URL is set) ----------------------
# Long random string used to sign JWT cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# JWT lifetime, e.g. 2h, 12h, 7d
JWT_EXPIRES_IN=2h

# --- CORS ---------------------------------------------------------------------
# Comma-separated list of allowed origins. Leave blank for same-origin only.
CORS_ORIGIN=
